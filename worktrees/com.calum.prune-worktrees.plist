<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.calum.prune-worktrees</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/calum/.local/bin/prune-worktrees</string>
        <string>--apply</string>
    </array>

    <!-- Run once at login, then every 15 min while logged in. Worktrees cost
         ~1G each (node_modules), so an hour of accrual is real disk. A pass is
         ~40s: one `git fetch` per worktree, plus a `gh` call only for branches
         that fail the cheap local merge tests. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- launchd starts jobs with a minimal PATH that excludes Homebrew, so
         `gh` (at /opt/homebrew/bin) silently fails to run and every
         squash-merged branch reads as "not merged". `git` is /usr/bin/git so
         the local merge tests worked and masked this. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/calum/.cache/prune-worktrees/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/calum/.cache/prune-worktrees/launchd.log</string>
</dict>
</plist>
