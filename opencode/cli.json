{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "blackout",
    "mode": "dark"
  },
  "keybinds": {
    "session.background": "<leader>z"
  },
  "plugins": [
    "-opencode.sidebar.context",
    "./plugins/subscription-usage",
    "./plugins/full-terminal-title"
  ],
  "terminal": {
    "title": false
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "permissions": "autoaccept",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": true,
    "tps": true,
    "new_location": "launch"
  },
  "tabs": {
    "mode": "off",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "animations": true,
  "prompt": {
    "paste": "compact"
  }
}
