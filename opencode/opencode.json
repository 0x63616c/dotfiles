{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@prevalentware/opencode-goal-plugin@0.1.54"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "open-computer-use": {
        "type": "local",
        "command": [
          "open-computer-use",
          "mcp"
        ]
      },
      "jev": {
        "type": "local",
        "command": [
          "/bin/sh",
          "-c",
          "exec /usr/bin/python3 \"${XDG_CONFIG_HOME:-$HOME/.config}/opencode/jev-launcher.py\""
        ]
      }
    }
  }
}
