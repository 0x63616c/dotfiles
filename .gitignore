# transient hook-migration backups (left by the symlink → file typechange dance)
git/hooks/*.old
git/hooks/*.clobbered

# QMK keyboard passwords — never commit/push
secrets.h
qmk/**/secrets.h

# QMK fork: 1.2G vendor tree, keeps its own git, re-clonable — never track here
qmk/qmk_firmware/

# restic — repo passwords and the rendered recovery sheet live in ~/.config and
# ~/.recovery by design. These patterns are belt-and-braces in case a copy ever
# lands here: this repo is public, and one of these leaking exposes every backup.
restic/env
restic/*password*
restic/*.key
restic/*-recovery.html

# Hammerspoon EmmyLua annotations — ~700 generated stub files, regenerated by
# EmmyLua.spoon whenever Hammerspoon updates. Output, not source.
hammerspoon/Spoons/EmmyLua.spoon/annotations/

# Claude Code's own skill-directory bookkeeping, written into ~/.claude/skills
# (which is this directory, via the per-skill symlinks). `synced/` is the
# bundled/marketplace skills Claude Code installs for itself and `.trash/` is
# where it parks deleted ones — both are its state, not dotfiles.
claude/skills/synced/
claude/skills/.trash/

# JetBrains project files (appear when the repo is opened in an IDE)
.idea/
