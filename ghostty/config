# Ghostty config, also read by cmux (it embeds Ghostty for its terminal
# surfaces). Lives at ~/.config/ghostty/config via symlink; the `hyper`
# theme it references is in themes/ next to it.

theme = hyper

font-family = "Geist Mono"
font-size = 16


window-padding-x = 8
window-padding-y = 8
window-width = 165
window-height = 38

split-divider-color = #444444
unfocused-split-opacity = 0.7

macos-icon = "xray"

keybind = shift+enter=text:\n
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

copy-on-select = clipboard

# Show destination preview for OSC 8 hyperlinks (text differs from URL)
link-previews = osc8
