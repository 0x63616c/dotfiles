for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$brew_bin" ]; then
    eval "$("$brew_bin" shellenv)"
    break
  fi
done
unset brew_bin
# User-installed launchers remain available in login shells.
[[ ! -d "$HOME/.local/bin" ]] || export PATH="$HOME/.local/bin:$PATH"
