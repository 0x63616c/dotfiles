# Use the local key directly for GitHub; 1Password keeps the backup.
Host github.com ssh.github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    IdentityAgent none

Include {{ .chezmoi.homeDir }}/.colima/ssh_config

Host homelab-macbook
    HostName 192.168.0.44
    User coding
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
