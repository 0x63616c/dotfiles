#!/usr/bin/env python3
# Own only Nix update behavior; preserve Claude's local preferences and hooks.
import json
import sys

text = sys.stdin.read()
settings = json.loads(text) if text.strip() else {}
if not isinstance(settings, dict):
    sys.exit("Claude settings must be a JSON object")
{{- $profile := get . "profile" | default (ternary "coding" "personal" (eq .chezmoi.username "coding")) }}
{{ if eq $profile "coding" -}}
env = settings.setdefault("env", {})
if not isinstance(env, dict):
    sys.exit("Claude settings.env must be a JSON object")
env["DISABLE_AUTOUPDATER"] = "1"
# Status line mirrors the coding starship prompt: [coding@host] dir git:(branch) ✗
settings["statusLine"] = {
    "type": "command",
    # Fields used (statusline JSON on stdin): workspace.current_dir, cwd, model.display_name,
    # context_window.{used_percentage,total_input_tokens,context_window_size},
    # rate_limits.{five_hour,seven_day}.{used_percentage,resets_at}, output_style.name.
    # Every field is optional and omitted when missing.
    "command": r"""input=$(cat)
JQ=/run/current-system/sw/bin/jq; [ -x "$JQ" ] || JQ=jq
j() { printf %s "$input" | "$JQ" -r "$1 // empty" 2>/dev/null; }
col() { if [ "$1" -ge 80 ]; then printf 31; elif [ "$1" -ge 50 ]; then printf 33; else printf 32; fi; }
sep() { printf ' \033[2m│\033[0m '; }
# row LABEL [COUNTDOWN]: start a new status line with the label and countdown padded so every bar lines up.
row() { printf '\n%-5s \033[2m%-9s\033[0m ' "$1" "${2:+($2)}"; }
# dur SECS: two most significant units: "2d 4h", "3h 12m", "45m", "30s" (a zero second unit is dropped).
dur() { if [ "$1" -ge 86400 ]; then printf '%sd' $(($1 / 86400)); [ $(($1 % 86400 / 3600)) -gt 0 ] && printf ' %sh' $(($1 % 86400 / 3600))
  elif [ "$1" -ge 3600 ]; then printf '%sh' $(($1 / 3600)); [ $(($1 % 3600 / 60)) -gt 0 ] && printf ' %sm' $(($1 % 3600 / 60))
  elif [ "$1" -ge 60 ]; then printf '%sm' $(($1 / 60)); else printf '%ss' "$1"; fi; return 0; }
# bar USED% COLOR [MARK%]: 20-cell bar (5% per cell) filled to USED%. MARK% (time elapsed) highlights the cell "now" falls
# in, in bold default colour (works on light and dark themes), without changing the width: █ if that cell is used, ▒ if not. Fill past it = over pace.
bar() { f=$((($1 * 20 + 50) / 100)); m=-1; [ -n "$3" ] && { m=$(($3 / 5)); [ "$m" -gt 19 ] && m=19; }; i=0
  while [ "$i" -lt 20 ]; do
    if [ "$i" -eq "$m" ]; then if [ "$i" -lt "$f" ]; then printf '\033[1m█\033[0m'; else printf '\033[1m▒\033[0m'; fi
    elif [ "$i" -lt "$f" ]; then printf '\033[%sm█\033[0m' "$2"; else printf '\033[2m░\033[0m'; fi
    i=$((i + 1)); done; }
# lim KEY LABEL WINDOW_SECS: bar coloured by pace (green under, yellow on pace, red over), used %, time to reset.
lim() { p=$(j ".rate_limits.$1.used_percentage"); [ -n "$p" ] || return 0; p=$(printf %.0f "$p"); r=$(j ".rate_limits.$1.resets_at"); r=${r%%.*}
  if [ -z "$r" ]; then row "$2"; bar "$p" "$(col "$p")"; printf ' %3s%%' "$p"; return 0; fi
  left=$((r - $(date +%s))); [ "$left" -lt 0 ] && left=0
  e=$((100 - left * 100 / $3)); [ "$e" -lt 0 ] && e=0; [ "$e" -gt 100 ] && e=100; d=$((p - e))
  if [ "$d" -gt 5 ]; then c=31; elif [ "$d" -lt -5 ]; then c=32; else c=33; fi
  rl=$(dur "$left")
  # "5h (4h 25m) █┃█░░░░░░░░ 18% 12%": countdown, bar, used % (pace colour), time elapsed % (dim).
  row "$2" "$rl"; bar "$p" "$c" "$e"; printf ' \033[%sm%3s%%\033[0m \033[2m%s%%\033[0m' "$c" "$p" "$e"; return 0; }
# tok N: token count as "96k" or "1M" / "1.5M".
tok() { if [ "$1" -ge 1000000 ]; then if [ $(($1 % 1000000)) -ge 100000 ]; then printf '%s.%sM' $(($1 / 1000000)) $(($1 % 1000000 / 100000)); else printf '%sM' $(($1 / 1000000)); fi; else printf '%sk' $(($1 / 1000)); fi; }
dir=$(j '.workspace.current_dir // .cwd'); [ -n "$dir" ] || dir=$PWD
br=$(git --no-optional-locks -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null)
printf '\033[38;5;160m[coding@%s]\033[0m \033[38;5;45m%s\033[0m' "$(hostname -s)" "$(basename "$dir")"
if [ -n "$br" ]; then printf ' \033[38;5;69mgit:(\033[38;5;141m%s\033[38;5;69m)\033[0m' "$br"; if [ -n "$(git --no-optional-locks -C "$dir" status --porcelain 2>/dev/null | head -1)" ]; then printf ' \033[38;5;178m✗\033[0m'; fi; fi
wt=$(j '.workspace.git_worktree // .worktree.name'); [ -n "$wt" ] && printf ' \033[38;5;141m⎇ %s\033[0m' "$wt"
m=$(j .model.display_name); [ -n "$m" ] && { sep; printf '\033[1m%s\033[0m' "$m"; }
ef=$(j .effort.level); [ -n "$ef" ] && printf ' %s' "$ef"
[ "$(j .fast_mode)" = true ] && printf ' \033[38;5;178m(fast)\033[0m'
os=$(j .output_style.name); [ -n "$os" ] && [ "$os" != default ] && { sep; printf '%s' "$os"; }
# Session line: name · running time · lines changed.
sn=$(j .session_name); ms=$(j .cost.total_duration_ms); la=$(j .cost.total_lines_added); lr=$(j .cost.total_lines_removed); ss=''
[ -n "$sn" ] && { printf '\n\033[38;5;45m%.48s\033[0m' "$sn"; ss=1; }
[ -n "$ms" ] && { [ -n "$ss" ] && printf ' \033[2m·\033[0m ' || printf '\n'; dur $((${ms%%.*} / 1000)); ss=1; }
if [ "${la:-0}" -gt 0 ] || [ "${lr:-0}" -gt 0 ]; then [ -n "$ss" ] && printf ' \033[2m·\033[0m ' || printf '\n'; printf '\033[32m+%s\033[0m \033[31m−%s\033[0m' "${la:-0}" "${lr:-0}"; fi
# Cache row: time until the prompt cache goes cold (bar drains; red when nearly cold), or what a cold cache will cost.
if [ "$(j .prompt_cache.warm)" = true ] && ex=$(j .prompt_cache.expires_at) && [ -n "$ex" ]; then
  cl=$((${ex%%.*} - $(date +%s))); [ "$cl" -lt 0 ] && cl=0; case "$(j .prompt_cache.ttl)" in 5m) tt=300 ;; *) tt=3600 ;; esac
  cr=$((cl * 100 / tt)); [ "$cr" -gt 100 ] && cr=100; if [ "$cr" -ge 40 ]; then cc=32; elif [ "$cr" -ge 15 ]; then cc=33; else cc=31; fi
  row cache "$(dur "$cl")"; bar "$cr" "$cc"; printf ' \033[%smwarm\033[0m' "$cc"
elif [ "$(j .prompt_cache.caching_observed)" = true ]; then
  rc=$(j .prompt_cache.recache_tokens_if_cold); row cache; printf '\033[2mcold\033[0m'; [ -n "$rc" ] && printf ' \033[2m· next message re-reads %s\033[0m' "$(tok "$rc")"
fi
cp=$(j .context_window.used_percentage)
if [ -n "$cp" ]; then cp=$(printf %.0f "$cp"); row ctx; bar "$cp" "$(col "$cp")"; printf ' \033[%sm%3s%%\033[0m' "$(col "$cp")" "$cp"; tk=$(j .context_window.total_input_tokens); sz=$(j .context_window.context_window_size); [ -n "$tk" ] && [ -n "$sz" ] && printf ' \033[2m%s/%s\033[0m' "$(tok "$tk")" "$(tok "$sz")"; fi
lim five_hour 5h 18000
lim seven_day 7d 604800
exit 0""",
    "refreshInterval": 30,
}
{{ end -}}
print(json.dumps(settings, indent=2) + "\n", end="")
