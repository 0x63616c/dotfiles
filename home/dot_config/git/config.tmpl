[user]
	name = {{ .name }}
	email = {{ .email }}
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519
[gpg]
	format = ssh
[gpg "ssh"]
	program = /usr/bin/ssh-keygen
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[core]
	excludesfile = ~/.config/git/ignore
[credential "https://github.com"]
	helper =
	helper = !{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/bin/gh auth git-credential
