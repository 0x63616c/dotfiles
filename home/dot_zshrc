# Managed by chezmoi: edit home/dot_zshrc in dotfiles. See README: Shell.
# Every integration is guarded, so a missing tool never breaks the shell.

# Aliases
alias reload='source "$HOME/.zshrc"'
alias code='cursor'
# Claude sessions launched via c bypass permission prompts.
alias c='claude --dangerously-skip-permissions'
alias cr='c --resume'

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY INC_APPEND_HISTORY

# Completion
autoload -Uz compinit && compinit -u

# Sensible options
setopt AUTO_CD INTERACTIVE_COMMENTS

# vov's tool from the ~/coding/vov checkout: `vov` rebuilds when needed, else runs the cached binary.
[[ ! -d "$HOME/coding/vov/bin" ]] || path+=("$HOME/coding/vov/bin")

# Claude accounts: ~/coding/vov (and its worktrees) runs on the work profile, ~/.claude-work; everywhere else runs on
# the personal default, ~/.claude. Each profile has its own login (see README: Claude accounts). c and cr come through here.
# In vov, Claude also gets vov's MCP keys from sops, for that process only (see vov/.mcp.json).
claude() {
  if [[ $PWD == $HOME/coding/vov(|-worktrees)(|/*) ]]; then
    local vov="$HOME/coding/vov/bin/vov"
    CLAUDE_CONFIG_DIR="$HOME/.claude-work" \
    PENPOT_MCP_KEY="$("$vov" admin secrets get access PENPOT_MCP_KEY 2>/dev/null)" \
    PENPOT_MCP_ACCESS_CLIENT_ID="$("$vov" admin secrets get access PENPOT_MCP_ACCESS_CLIENT_ID 2>/dev/null)" \
    PENPOT_MCP_ACCESS_CLIENT_SECRET="$("$vov" admin secrets get access PENPOT_MCP_ACCESS_CLIENT_SECRET 2>/dev/null)" \
      command claude "$@"
  else
    command claude "$@"
  fi
}

# Tool integrations
command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"          # tool versions
command -v wtp >/dev/null 2>&1 && eval "$(wtp shell-init zsh)"          # git worktrees: completion, cd on add
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"          # project .envrc (e.g. vov's Nix shell) on cd
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"          # `z` jumps to frequent directories
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"      # prompt

# Plugins from Homebrew; syntax-highlighting must be sourced last among plugins.
if command -v brew >/dev/null 2>&1; then
  _brew_prefix="$(brew --prefix)"
  [ -f "$_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  unset _brew_prefix
fi

# Keep the CLI matching this Rex server first after every interactive init or reload.
if [ -n "$REX_BIN_DIR" ] && [ "${PATH%%:*}" != "$REX_BIN_DIR" ]; then
  export PATH="$REX_BIN_DIR:$PATH"
fi
